# --- Required ---
# Supabase backend (auth, sync, storage)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# --- Optional: book-cover providers (graceful fallback chain) ---
# Order tried at runtime: Kakao -> Naver -> Google Books.
# Each provider is silently skipped when its key(s) are missing, so
# any subset is valid. Google Books works without a key for low volume.
#
# Kakao:  https://developers.kakao.com  (Register app -> REST API key)
VITE_KAKAO_REST_KEY=

# Naver:  https://developers.naver.com  (Open API -> Application -> 검색)
# NOTE: Naver requires CORS-allowed callers. Native (iOS / Android via
# Capacitor) works as-is; web dev server may be blocked by CORS — that
# is fine, the orchestrator just falls through to Google.
VITE_NAVER_CLIENT_ID=
VITE_NAVER_CLIENT_SECRET=

# --- Optional: store donation (RevenueCat + StoreKit / Play Billing) ---
# Keep the app free; users can tip voluntarily via store IAP only.
#
# RevenueCat public SDK keys (not secret keys)
VITE_REVENUECAT_IOS_API_KEY=
VITE_REVENUECAT_ANDROID_API_KEY=

# Comma-separated product IDs (consumable tips) — same IDs on both stores
# Example: app.quote.note.tip.small,app.quote.note.tip.medium,app.quote.note.tip.large
VITE_IAP_TIP_PRODUCT_IDS=

# IAP 심사용 스크린샷 미리보기 (RevenueCat 없이 mock UI)
# "true" → tipPreview.ts 문구/가격으로 후원 UI 표시. 출시 빌드 전에는 끄세요.
VITE_IAP_PREVIEW=

# --- Optional: Quote Pro (monthly subscription) ---
# See PRO_SUBSCRIPTION.md. Tips do NOT unlock Pro.
# Product + entitlement must match App Store / Play / RevenueCat.
VITE_IAP_PRO_PRODUCT_ID=app.quote.note.pro.monthly
VITE_IAP_PRO_ENTITLEMENT_ID=pro
# Mock subscribe UI (no StoreKit). Tap Subscribe to unlock locally.
VITE_PRO_PREVIEW=
# Force Pro active for QA of gated screens (release builds: leave empty)
VITE_PRO_FORCE_ACTIVE=
